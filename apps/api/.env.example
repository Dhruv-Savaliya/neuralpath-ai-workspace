PORT=4000
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side AI providers. Never expose these in NEXT_PUBLIC variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=true # Enable only when your Groq account quota/cost policy is approved

# Cloudflare Workers AI embeddings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIMENSIONS=1024

# Second-stage reranker (Cloudflare Workers AI)
RERANK_ENABLED=false
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base

